<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>se.hirt</groupId>
        <artifactId>mnemic-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>mnemic-server</artifactId>
    <name>Mnemic MCP server</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-stdio</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <!-- Canonical state lives in SQLite. The driver ships its own GraalVM native-image metadata and FTS5. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                            <goal>native-image-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- The ONNX Runtime shared library for the platform this build runs on, taken out of the
                     runtime's own Maven Central artifact and carried as a resource (OrtLibrary pins its hash;
                     OrtLibraryTest fails the build when artifact and pin disagree). Code is never fetched at run
                     time; only the embedding model is. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-onnxruntime</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.microsoft.onnxruntime</groupId>
                                    <artifactId>onnxruntime</artifactId>
                                    <version>${mnemic.ort.version}</version>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <includes>ai/onnxruntime/native/${mnemic.ort.platform}/onnxruntime.dll,ai/onnxruntime/native/${mnemic.ort.platform}/libonnxruntime.so,ai/onnxruntime/native/${mnemic.ort.platform}/libonnxruntime.dylib</includes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- The tests that need the real embedder read these; the local-embedder profiles fill them from
                     ~/.mnemic/models when a served store has left the runtime and the model there, else they pass the
                     caller's environment through, and the tests skip when neither exists. -->
                <configuration>
                    <environmentVariables>
                        <MNEMIC_ORT_LIBRARY>${mnemic.test.ort.library}</MNEMIC_ORT_LIBRARY>
                        <MNEMIC_EMBED_MODEL>${mnemic.test.embed.model}</MNEMIC_EMBED_MODEL>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <MNEMIC_ORT_LIBRARY>${mnemic.test.ort.library}</MNEMIC_ORT_LIBRARY>
                        <MNEMIC_EMBED_MODEL>${mnemic.test.embed.model}</MNEMIC_EMBED_MODEL>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <mnemic.ort.version>1.29.0</mnemic.ort.version>
        <!-- Where the embedder tests find the runtime and the model: the environment unless a profile below finds
             them under ~/.mnemic/models (the version in the activation paths is spelled out, since a profile cannot
             read a property). -->
        <mnemic.test.ort.library>${env.MNEMIC_ORT_LIBRARY}</mnemic.test.ort.library>
        <mnemic.test.embed.model>${env.MNEMIC_EMBED_MODEL}</mnemic.test.embed.model>
        <mnemic.test.models>${user.home}/.mnemic/models</mnemic.test.models>
        <!-- Overridden by the platform profiles below; 'none' bundles nothing on a platform the artifact lacks. -->
        <mnemic.ort.platform>none</mnemic.ort.platform>
    </properties>

    <profiles>
        <profile>
            <id>local-embedder-win</id>
            <activation>
                <file>
                    <exists>${user.home}/.mnemic/models/onnxruntime-1.29.0/onnxruntime.dll</exists>
                </file>
            </activation>
            <properties>
                <mnemic.test.ort.library>${mnemic.test.models}/onnxruntime-${mnemic.ort.version}/onnxruntime.dll</mnemic.test.ort.library>
                <mnemic.test.embed.model>${mnemic.test.models}/granite-embedding-311m-multilingual-r2</mnemic.test.embed.model>
            </properties>
        </profile>
        <profile>
            <id>local-embedder-linux</id>
            <activation>
                <file>
                    <exists>${user.home}/.mnemic/models/onnxruntime-1.29.0/libonnxruntime.so</exists>
                </file>
            </activation>
            <properties>
                <mnemic.test.ort.library>${mnemic.test.models}/onnxruntime-${mnemic.ort.version}/libonnxruntime.so</mnemic.test.ort.library>
                <mnemic.test.embed.model>${mnemic.test.models}/granite-embedding-311m-multilingual-r2</mnemic.test.embed.model>
            </properties>
        </profile>
        <profile>
            <id>local-embedder-mac</id>
            <activation>
                <file>
                    <exists>${user.home}/.mnemic/models/onnxruntime-1.29.0/libonnxruntime.dylib</exists>
                </file>
            </activation>
            <properties>
                <mnemic.test.ort.library>${mnemic.test.models}/onnxruntime-${mnemic.ort.version}/libonnxruntime.dylib</mnemic.test.ort.library>
                <mnemic.test.embed.model>${mnemic.test.models}/granite-embedding-311m-multilingual-r2</mnemic.test.embed.model>
            </properties>
        </profile>
        <profile>
            <id>ort-win-x64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <mnemic.ort.platform>win-x64</mnemic.ort.platform>
            </properties>
        </profile>
        <profile>
            <id>ort-linux-x64</id>
            <activation>
                <os>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <mnemic.ort.platform>linux-x64</mnemic.ort.platform>
            </properties>
        </profile>
        <profile>
            <id>ort-linux-aarch64</id>
            <activation>
                <os>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <mnemic.ort.platform>linux-aarch64</mnemic.ort.platform>
            </properties>
        </profile>
        <profile>
            <id>ort-osx-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <mnemic.ort.platform>osx-aarch64</mnemic.ort.platform>
            </properties>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
